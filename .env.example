# Telegram bot token from @BotFather
BOT_TOKEN=123456:ABC-DEF...

# Telegram MTProto credentials from https://my.telegram.org (cần cho Phase 2 - Pyrogram)
API_ID=12345678
API_HASH=abcdef0123456789abcdef0123456789

# Redis (Railway addon hoặc local)
REDIS_URL=redis://default:password@host:6379

# Admin Telegram user_id (lấy từ @userinfobot) - dùng cho /stats
ADMIN_USER_ID=123456789

# Cookie Douyin dạng base64 (nội dung file cookies.txt encode base64)
# cat cookies.txt | base64 -w0
DOUYIN_COOKIES_B64=

# Folder tạm chứa file tải về (auto-clean sau khi gửi)
DOWNLOAD_DIR=/tmp/dl

# Rate limit: tối đa N video / WINDOW giây / user
RATE_LIMIT_COUNT=10
RATE_LIMIT_WINDOW=600

# Telegram giới hạn 50MB qua Bot API. Phase 2 sẽ tăng lên qua Pyrogram.
MAX_FILESIZE_MB=50

# Cache file_id trong Redis (giây). 30 ngày = 2592000
CACHE_TTL=2592000

# Channel batch download (Phase 3)
CHANNEL_DEFAULT_LIMIT=20
CHANNEL_MAX_LIMIT=50
